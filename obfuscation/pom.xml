<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.kk.greet</groupId>
  <artifactId>obfuscation</artifactId>
  <version>1.0.0</version>
  <!-- Contains only ObfuscationRunner: it derives ProGuard keep rules from each
       PDE-built bundle's own metadata (MANIFEST.MF + OSGI-INF DS descriptors)
       and obfuscates every bundle jar found in Deployment/build - no per-bundle
       configuration. PDE (or scripts/build-bundles) stays the compiler. -->
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Repo root, relative to this module. -->
    <repo.root>${project.basedir}/..</repo.root>
    <!-- Where scripts/build-bundles (the PDE export stand-in) puts bundle jars. -->
    <bundles.input.dir>${repo.root}/Deployment/build</bundles.input.dir>
    <!-- Target-platform jars (OSGi framework + DS APIs), used as -libraryjars.
         The GREET_TARGET_DIR env var overrides this default (see the profile
         below), so build-bundles and the obfuscation step read the same
         location; an explicit -Ddeployment.target.dir= still wins over both. -->
    <deployment.target.dir>${repo.root}/Deployment/target</deployment.target.dir>
  </properties>

  <profiles>
    <profile>
      <id>env-target-dir</id>
      <activation>
        <property>
          <name>env.GREET_TARGET_DIR</name>
        </property>
      </activation>
      <properties>
        <deployment.target.dir>${env.GREET_TARGET_DIR}</deployment.target.dir>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <!-- The runner drives ProGuard via its (de facto stable) programmatic entry
         points: Configuration/ConfigurationParser/ProGuard. 7.9.x reads the
         java.base of current JDKs (7.5.0 rejected anything newer than JDK 21). -->
    <dependency>
      <groupId>com.guardsquare</groupId>
      <artifactId>proguard-base</artifactId>
      <version>7.9.1</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- Match the repo-wide Java 8 convention (runs under JDK 21). -->
          <release>8</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>obfuscate-bundles</id>
            <phase>package</phase>
            <goals>
              <goal>java</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>com.kk.greet.obfuscation.ObfuscationRunner</mainClass>
          <arguments>
            <argument>${bundles.input.dir}</argument>
            <argument>${project.build.directory}</argument>
            <argument>${project.basedir}/proguard-common.conf</argument>
            <argument>${deployment.target.dir}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
