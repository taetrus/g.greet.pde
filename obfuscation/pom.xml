<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.kk.greet</groupId>
  <artifactId>obfuscation</artifactId>
  <version>1.0.0</version>
  <!-- No sources of its own: this module only obfuscates a PDE-built bundle jar. -->
  <packaging>pom</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Repo root, relative to this module. -->
    <repo.root>${project.basedir}/..</repo.root>
    <!-- The PDE-built (here: scripts/build-bundles.sh) input bundle jar. -->
    <greet.imp.jar>${repo.root}/Deployment/build/com.kk.greet.imp.jar</greet.imp.jar>
    <greet.api.jar>${repo.root}/Deployment/build/com.kk.greet.api.jar</greet.api.jar>
  </properties>

  <dependencies>
    <!-- JDK-21-capable ProGuard; provides the proguard.ProGuard main class on the exec classpath. -->
    <dependency>
      <groupId>com.guardsquare</groupId>
      <artifactId>proguard-base</artifactId>
      <version>7.5.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- pom-packaged modules bind no goals that create target/; ProGuard's
           -printmapping/-outjars won't create missing parent dirs, so make it
           ourselves before the obfuscation exec runs (else: FileNotFoundException). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>ensure-output-dir</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>obfuscate-imp-bundle</id>
            <phase>package</phase>
            <goals>
              <goal>java</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>proguard.ProGuard</mainClass>
          <!-- Explicit invocation: jar paths here (Maven-resolved), keep-rules in proguard.conf. -->
          <arguments>
            <argument>-injars</argument>
            <argument>${greet.imp.jar}</argument>
            <argument>-outjars</argument>
            <argument>${project.build.directory}/com.kk.greet.imp-obf.jar</argument>
            <argument>-libraryjars</argument>
            <argument>${java.home}/jmods/java.base.jmod</argument>
            <argument>-libraryjars</argument>
            <argument>${greet.api.jar}</argument>
            <argument>-printmapping</argument>
            <argument>${project.build.directory}/mapping.txt</argument>
            <argument>@${project.basedir}/proguard.conf</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
